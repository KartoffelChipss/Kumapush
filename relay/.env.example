# --- Required ---
POSTGRES_PASSWORD=change-me

# APNs credentials (Apple Developer > Keys). The .p8 key file itself is
# mounted from APNS_AUTH_KEY_FILE (default ./authkey.p8).
APNS_KEY_ID=
APNS_TEAM_ID=
APP_BUNDLE_IDENTIFIER=

# --- Optional ---
# Host port the relay is published on (the container always listens on 4321).
# RELAY_PORT=4321
# APNS_AUTH_KEY_FILE=./authkey.p8

# Set when running behind a reverse proxy so client IPs (used by rate limiting)
# are read from the proxy header. TRUSTED_PROXIES must contain the proxy's
# address as seen from the relay container (e.g. the Docker network gateway).
# BEHIND_PROXY=true
# PROXY_HEADER=X-Forwarded-For
# TRUSTED_PROXIES=172.18.0.1

# Use the APNs sandbox instead of production (development builds of the app).
# ENV=development
