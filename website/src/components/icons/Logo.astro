    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="logo-svg"
>
    <path d="M10.268 21a2 2 0 0 0 3.464 0"></path>
    <path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path>
    <circle cx="9.84" cy="12.38" r="1.24" fill="currentColor" stroke="none"></circle>
    <circle cx="14.16" cy="12.38" r="1.24" fill="currentColor" stroke="none"></circle>
</svg>
