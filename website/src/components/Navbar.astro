---
import Logo from './icons/Logo.astro';
import Github from './icons/Github.astro';
import Button from './ui/Button.astro';
import { Menu, X } from '@lucide/astro';
import { LINKS, ANCHORS } from '../lib/links';
---

<nav class="site-nav" aria-label="Main">
    <div class="nav-in">
        <a href={LINKS.home} class="logo">
            <Logo size={24} />
            KumaPush
        </a>

        <ul class="nav-links" id="nav-links">
            <li><a href={ANCHORS.how}>How it works</a></li>
            <li><a href={ANCHORS.features}>Features</a></li>
            <li><a href={ANCHORS.start}>Get started</a></li>
            <li><a href={LINKS.docs}>Docs</a></li>
            <li class="mobile-link">
                <a href={LINKS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
            </li>
        </ul>

        <div class="nav-r">
            <Button href={LINKS.github} size="sm" variant="outline" newtab={true}>
                <Github />
                GitHub
            </Button>

            <button
                class="nav-toggle"
                id="nav-toggle"
                type="button"
                aria-label="Toggle menu"
                aria-expanded="false"
                aria-controls="nav-links"
            >
                <Menu class="icon-menu" />
                <X class="icon-close" />
            </button>
        </div>
    </div>
</nav>

<script>
    const toggle = document.getElementById('nav-toggle');
    const links = document.getElementById('nav-links');

    toggle?.addEventListener('click', () => {
        const isOpen = links?.classList.toggle('open');
        toggle.classList.toggle('open', !!isOpen);
        toggle.setAttribute('aria-expanded', String(!!isOpen));
    });

    links?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
            links.classList.remove('open');
            toggle?.classList.remove('open');
            toggle?.setAttribute('aria-expanded', 'false');
        });
    });
</script>
